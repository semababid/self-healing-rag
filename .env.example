# Optional. Copy to .env and uncomment what you want to change.
# The values shown are the defaults.

# Ollama model, and where Ollama is running
# LLM_MODEL=qwen3.5:9b
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_THINKING=0

# Embeddings and chunking (run `python -m src.ingest` again after changing these)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120

# Retrieval and retries
# RETRIEVER_K=4
# MAX_RETRIES=2
