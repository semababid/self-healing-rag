# Optional. Copy to .env and uncomment what you want to change.
# The values shown are the defaults. EXPERIMENTS.md explains how they were chosen.

# Ollama model, and where Ollama is running
# LLM_MODEL=qwen3.5:9b
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_THINKING=0

# Embeddings and chunking (run `python -m src.ingest` again after changing these)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120

# Retrieval: "vector" or "hybrid" (vector plus keyword search)
# SEARCH=vector
# RETRIEVER_K=4
# Ask the model to drop irrelevant chunks before answering (1 = on)
# FILTER_CHUNKS=0
# On a retry, keep the chunks found earlier as well as the new ones (1 = on)
# KEEP_CHUNKS=0

# Retries
# MAX_RETRIES=2

# Where every question and answer is logged
# RUNS_FILE=runs/runs.jsonl
