# Copy this file to `.env` and fill in your key:
#   cp .env.example .env
#
# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (sensible defaults are set in src/config.py)
# Generation + critic model. Cheaper options: claude-haiku-4-5, claude-sonnet-5
# CLAUDE_MODEL=claude-opus-4-8

# Local embedding model (runs on your machine, no API cost)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval / self-healing behaviour
# RETRIEVER_K=4
# MAX_RETRIES=2
